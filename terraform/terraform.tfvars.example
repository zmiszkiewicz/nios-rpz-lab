###############################################################################
# Example variables — copy to terraform.tfvars and fill in.
###############################################################################
# Inside Instruqt none of this file is used: track_scripts/setup-shell exports
# TF_VAR_* from Instruqt secrets and the AWS sandbox instead. This file is for
# running the stack by hand.
#
# terraform.tfvars is gitignored. Do not commit real values.
###############################################################################

# --- Required ----------------------------------------------------------------

# Local Administrator password on the Windows desktop. Must match the password
# in the track's setup-rdpclient Guacamole mapping.
windows_admin_password = "REPLACE_ME"

# Infoblox CSP join token for the tenant the NIOS-X host should register with.
# Create one in the portal under Configure > Administration > Join Tokens. It is
# tenant-specific and short-lived, which is why there is no default.
infoblox_join_token = "REPLACE_ME"

# --- NIOS-X image ------------------------------------------------------------

# Optional. Defaults to the NIOS-X image tech-summit-security-niosx uses in
# eu-central-1, so you only need this when the image is rotated or you move
# region. NOT the AWS Marketplace listing. Find yours with:
#   aws ec2 describe-images --region eu-central-1 --owners <infoblox-account-id> \
#     --filters "Name=name,Values=*niosx*" --query 'Images[].[ImageId,Name]' --output table
# niosx_ami_id = "ami-08659b5070b66249d"

# --- Environment -------------------------------------------------------------

aws_region  = "eu-central-1"
instruqt_id = "local"

# --- Networking --------------------------------------------------------------

vpc_cidr    = "10.100.0.0/16"
subnet_cidr = "10.100.0.0/24"

# niosx_private_ip is also the resolver address baked into the desktop at boot.
niosx_private_ip   = "10.100.0.200"
desktop_private_ip = "10.100.0.110"

# Narrow this to your own egress IP when running outside Instruqt.
management_ingress_cidrs = ["0.0.0.0/0"]

# --- Sizing ------------------------------------------------------------------

# m5.large is the documented minimum for a NIOS-X host running the DFP service.
niosx_instance_type   = "m5.large"
desktop_instance_type = "t3.medium"

windows_ami_name_filter = "Windows_Server-2022-English-Full-Base-*"

# --- Infoblox portal ---------------------------------------------------------

# Override for a regional CSP instance, e.g. https://csp.eu.infoblox.com.
portal_url = "https://portal.infoblox.com"
